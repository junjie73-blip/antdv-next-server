/// ==================== 报表异步导出任务 ====================
model rp_export_task {
  task_id       String    @id @default(uuid()) @db.Uuid
  tenant_id     String    @db.Uuid
  user_id       String    @db.Uuid
  report_code   String    @db.VarChar(64)
  export_type   String    @db.VarChar(20) /// excel | pdf | html | csv
  params        Json?
  /// pending | processing | completed | failed | cancelled
  status        String    @default("pending") @db.VarChar(20)
  /// 进度 0-100
  progress      Int       @default(0) @db.SmallInt
  row_count     Int       @default(0)
  /// 文件信息
  file_url      String?   @db.VarChar(512)
  file_name     String?   @db.VarChar(256)
  file_size     BigInt?
  /// 失败信息
  error_msg     String?   @db.Text
  /// 重试计数
  retry_count   Int       @default(0) @db.SmallInt
  duration_ms   Int?
  /// BullMQ Job ID（用于取消/查询）
  job_id        String?   @db.VarChar(64)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  started_at    DateTime? @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)
  expires_at    DateTime? @db.Timestamptz(6) /// 文件过期时间
  max_retries   Int       @default(3) @db.SmallInt
  /**
   * 下次重试时间
   */
  next_retry_at DateTime? @db.Timestamptz(6)
  /**
   * 最后一次错误类型
   */
  error_type    String?   @db.VarChar(20)
  /**
   * 完整错误堆栈（截断）
   */
  error_stack   String?   @db.Text
  is_deleted    Int       @default(0) @db.SmallInt

  @@index([status, tenant_id])
  @@index([tenant_id, user_id, status, created_at(sort: Desc)])
  @@index([status, created_at])
  @@index([expires_at])
  @@index([status, next_retry_at])
  @@map("rp_export_task")
}

