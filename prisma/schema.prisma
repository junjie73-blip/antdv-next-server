generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ==================== 租户表 ====================
/// 租户表，存储多租户信息
model sys_tenant {
  tenant_id     String    @id @default(uuid()) @db.Uuid
  tenant_code   String    @unique @db.VarChar(64)
  tenant_name   String    @db.VarChar(128)
  contact_name  String?   @db.VarChar(64)
  contact_phone String?   @db.VarChar(32)
  contact_email String?   @db.VarChar(128)
  status        String    @default("1") @db.VarChar(10)
  expire_time   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  is_deleted    Int       @default(0) @db.SmallInt

  @@index([tenant_code])
  @@index([is_deleted])
  @@index([status])
  @@map("sys_tenant")
}

// ==================== 用户表 ====================
model sys_user {
  user_id              String          @id @default(uuid()) @db.Uuid
  tenant_id            String          @db.Uuid
  username             String          @db.VarChar(64)
  password             String          @db.VarChar(256)
  real_name            String?         @db.VarChar(64)
  phone                String?         @db.VarChar(32)
  email                String?         @db.VarChar(128)
  avatar               String?         @db.VarChar(512)
  gender               Int?            @db.SmallInt
  status               String          @default("1") @db.VarChar(10)
  sort_order           Int             @default(0) @db.SmallInt
  last_login_ip        String?         @db.VarChar(64)
  last_login_time      DateTime?       @db.Timestamptz(6)
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime        @updatedAt @db.Timestamptz(6)
  created_by           String?         @db.Uuid
  updated_by           String?         @db.Uuid
  password_changed_at  DateTime?       @db.Timestamptz(6)
  must_change_password Int             @default(0) @db.SmallInt
  is_deleted           Int             @default(0) @db.SmallInt
  id_card              String?         @db.VarChar(18) // 身份证号
  phone_enc            String?         @db.Text // 加密后的手机号
  phone_hash           String?         @db.VarChar(64) // 用于查找
  cancelled_at         DateTime?       @db.Timestamptz(6) // 注销申请时间
  cancel_reason        String?         @db.VarChar(512) // 注销原因
  cancel_effective     DateTime?       @db.Timestamptz(6) // 生效时间（7天后）
  id_card_enc          String?         @db.Text // 加密后的身份证号
  id_card_hash         String?         @db.VarChar(64) // 用于查找
  email_verified       Int             @default(0) @db.SmallInt // 0未验证 1已验证
  email_verified_at    DateTime?       @db.Timestamptz(6)
  sys_user_role        sys_user_role[]
  sys_user_dept        sys_user_dept[]

  @@unique([tenant_id, username])
  @@index([tenant_id])
  @@index([is_deleted])
  @@index([status])
  @@map("sys_user")
}

/// 验证码表（通用）
model sys_verify_code {
  id         String    @id @default(uuid()) @db.Uuid
  tenant_id  String    @db.Uuid
  user_id    String?   @db.Uuid
  target     String    @db.VarChar(128) // 邮箱或手机号
  code       String    @db.VarChar(16)
  scene      String    @db.VarChar(32) // email_bind | email_change | pwd_reset | login
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now())
  created_by String?   @db.Uuid

  @@index([tenant_id, target, scene])
  @@index([expires_at])
  @@map("sys_verify_code")
}

// ==================== 角色表 ====================
model sys_role {
  role_id     String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  role_code   String   @db.VarChar(64)
  role_name   String   @db.VarChar(128)
  description String?  @db.VarChar(512)
  sort_order  Int      @default(0)
  status      String   @default("1") @db.VarChar(10)
  data_scope  String   @default("1") @db.VarChar(10) /// 数据范围：1-全部 2-自定义 3-本部门 4-本部门及以下 5-仅本人
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  created_by  String?  @db.Uuid
  updated_by  String?  @db.Uuid
  is_deleted  Int      @default(0) @db.SmallInt

  // ===== 反向关系字段 =====
  sys_user_role       sys_user_role[]
  sys_role_menu       sys_role_menu[]
  sys_role_permission sys_role_permission[]
  sys_role_dept       sys_role_dept[]

  @@unique([tenant_id, role_code])
  @@index([tenant_id])
  @@index([is_deleted])
  @@index([status])
  @@map("sys_role")
}

// ==================== 部门表 ====================
/// 部门表，支持树形组织结构
model sys_dept {
  dept_id    String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  parent_id  String?  @db.Uuid
  dept_code  String   @db.VarChar(64)
  dept_name  String   @db.VarChar(128)
  leader     String?  @db.VarChar(64)
  leader_id  String?  @db.Uuid
  phone      String?  @db.VarChar(32)
  email      String?  @db.VarChar(128)
  sort_order Int      @default(0)
  status     String   @default("1") @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  is_deleted Int      @default(0) @db.SmallInt

  // ===== 反向关系字段 =====
  sys_user_dept sys_user_dept[]
  sys_role_dept sys_role_dept[]

  @@unique([tenant_id, dept_code])
  @@index([tenant_id])
  @@index([is_deleted])
  @@index([leader_id])
  @@index([status])
  @@map("sys_dept")
}

// ==================== 菜单表 ====================
model sys_menu {
  menu_id       String          @id @default(uuid()) @db.Uuid
  tenant_id     String          @db.Uuid
  parent_id     String?         @db.Uuid
  menu_name     String          @db.VarChar(128)
  menu_type     Int             @db.SmallInt /// 1-目录 2-菜单 3-按钮
  icon          String?         @db.VarChar(128)
  path          String?         @db.VarChar(256)
  component     String?         @db.VarChar(256)
  permission    String?         @db.VarChar(128)
  sort_order    Int             @default(0)
  status        String          @default("1") @db.VarChar(10)
  is_platform   Int             @default(0) @db.SmallInt /// 1-平台级菜单，0-业务菜单
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)
  created_by    String?         @db.Uuid
  updated_by    String?         @db.Uuid
  is_deleted    Int             @default(0) @db.SmallInt
  micro_app     Json? /// 微应用配置 { name, url, baseroute, ... }
  is_external   Boolean         @default(false) /// 是否外链（新窗口打开）
  layout        String?         @db.VarChar(20) /// 布局类型：blank 表示无布局全屏
  hidden        Boolean         @default(false) /// 侧边栏是否隐藏
  keep_alive    Boolean         @default(false)
  // ===== 反向关系字段 =====
  sys_role_menu sys_role_menu[]

  @@index([tenant_id])
  @@index([is_deleted])
  @@index([status])
  @@map("sys_menu")
}

// ==================== 权限表 ====================
/// 权限表，定义系统操作权限点
model sys_permission {
  perm_id       String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  perm_code     String   @db.VarChar(128)
  perm_name     String   @db.VarChar(128)
  resource_type String   @db.VarChar(32)
  perm_action   String?  @db.VarChar(32)
  description   String?  @db.VarChar(512)
  status        String   @default("1") @db.VarChar(10)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  created_by    String?  @db.Uuid
  updated_by    String?  @db.Uuid
  is_deleted    Int      @default(0) @db.SmallInt

  // ===== 反向关系字段 =====
  sys_role_permission sys_role_permission[]

  @@unique([tenant_id, perm_code])
  @@index([tenant_id])
  @@index([is_deleted])
  @@index([status])
  @@map("sys_permission")
}

// ==================== 数据字典类型 ====================
/// 数据字典类型表
model sys_dict_type {
  dict_type_id String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  dict_code    String   @db.VarChar(64)
  dict_name    String   @db.VarChar(128)
  description  String?  @db.VarChar(512)
  status       String   @default("1") @db.VarChar(10)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  created_by   String?  @db.Uuid
  updated_by   String?  @db.Uuid
  is_deleted   Int      @default(0) @db.SmallInt

  @@unique([tenant_id, dict_code])
  @@index([tenant_id])
  @@index([is_deleted])
  @@index([status])
  @@map("sys_dict_type")
}

// ==================== 数据字典数据 ====================
/// 数据字典数据表
model sys_dict_data {
  dict_data_id String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  dict_type_id String   @db.Uuid
  dict_label   String   @db.VarChar(128)
  dict_value   String   @db.VarChar(128)
  sort_order   Int      @default(0)
  status       String   @default("1") @db.VarChar(10)
  remark       String?  @db.VarChar(512)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  created_by   String?  @db.Uuid
  updated_by   String?  @db.Uuid
  is_deleted   Int      @default(0) @db.SmallInt

  @@index([tenant_id, dict_type_id])
  @@index([is_deleted])
  @@index([status])
  @@map("sys_dict_data")
}

// ==================== 通知公告 ====================
model sys_notice {
  notice_id    String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  title        String    @db.VarChar(256)
  content      String?   @db.Text
  notice_type  Int       @db.SmallInt
  status       String    @default("1") @db.VarChar(10)
  publish_time DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  template_id  String?   @db.Uuid
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  created_by   String?   @db.Uuid
  updated_by   String?   @db.Uuid
  is_deleted   Int       @default(0) @db.SmallInt
  priority     Int       @default(0) @db.SmallInt // 0-普通 1-重要 2-紧急
  is_top       Int       @default(0) @db.SmallInt // 是否置顶
  send_status  String?   @default("0") @db.VarChar(1) // 0未发送 1已发送
  send_time    DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  revoked_by   String?   @db.Uuid

  target_users sys_notice_user[]

  @@index([tenant_id])
  @@index([is_deleted])
  @@index([status])
  @@index([template_id])
  @@map("sys_notice")
}

// ==================== 通知用户关联表 ====================
model sys_notice_user {
  id         String    @id @default(uuid()) @db.Uuid
  notice_id  String    @db.Uuid
  user_id    String    @db.Uuid
  tenant_id  String    @db.Uuid
  is_read    Int       @default(0) @db.SmallInt
  read_time  DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6) /// 创建时间
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6) /// 更新时间
  is_deleted Int       @default(0) @db.SmallInt // 撤回后标记删除
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid

  notice sys_notice @relation(fields: [notice_id], references: [notice_id], onDelete: Cascade)

  @@unique([notice_id, user_id, is_deleted])
  @@index([tenant_id, user_id, is_read])
  @@map("sys_notice_user")
}

// ==================== 审计日志 ====================
model sys_audit_log {
  log_id         String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  user_id        String?  @db.Uuid
  username       String?  @db.VarChar(64)
  operation      String   @db.VarChar(128)
  method         String   @db.VarChar(32)
  request_url    String   @db.VarChar(512)
  request_params String?  @db.Text
  response_data  String?  @db.Text
  ip_address     String   @db.VarChar(64)
  user_agent     String?  @db.VarChar(512)
  execute_time   Int      @default(0)
  status         String   @default("1") @db.VarChar(10)
  error_msg      String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  created_by     String?  @db.Uuid
  metadata       Json?
  trace_id       String?  @db.VarChar(64)

  @@index([trace_id])
  @@index([log_id, created_at])
  @@index([tenant_id, created_at(sort: Desc)])
  @@index([tenant_id, user_id, created_at])
  @@index([tenant_id, operation, created_at])
  @@index([created_at])
  @@index([tenant_id, method, status, created_at, log_id])
  @@map("sys_audit_log")
}

// ==================== 用户角色关联表 ====================
model sys_user_role {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  role_id    String   @db.Uuid
  tenant_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  created_by String?  @db.Uuid
  user       sys_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role       sys_role @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([tenant_id])
  @@index([user_id])
  @@index([role_id])
  @@map("sys_user_role")
}

// ==================== 用户部门关联表 ====================
model sys_user_dept {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  dept_id    String   @db.Uuid
  tenant_id  String   @db.Uuid
  is_primary Int      @default(0) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  created_by String?  @db.Uuid
  user       sys_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  dept       sys_dept @relation(fields: [dept_id], references: [dept_id], onDelete: Cascade)

  @@unique([user_id, dept_id])
  @@index([tenant_id])
  @@index([user_id])
  @@index([dept_id])
  @@map("sys_user_dept")
}

// ==================== 角色菜单关联表 ====================
model sys_role_menu {
  id         String   @id @default(uuid()) @db.Uuid /// 关联ID（主键，UUID）
  role_id    String   @db.Uuid /// 角色ID
  menu_id    String   @db.Uuid /// 菜单ID
  tenant_id  String   @db.Uuid /// 所属租户ID
  created_at DateTime @default(now()) @db.Timestamptz(6) /// 创建时间
  created_by String?  @db.Uuid /// 创建人ID

  role sys_role @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  menu sys_menu @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade)

  @@unique([role_id, menu_id])
  @@index([tenant_id])
  @@index([role_id])
  @@index([menu_id])
  @@map("sys_role_menu")
}

// ==================== 角色权限关联表 ====================
model sys_role_permission {
  id         String   @id @default(uuid()) @db.Uuid
  role_id    String   @db.Uuid
  perm_id    String   @db.Uuid
  tenant_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6) /// 创建时间
  created_by String?  @db.Uuid /// 创建人ID

  role       sys_role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  permission sys_permission @relation(fields: [perm_id], references: [perm_id], onDelete: Cascade)

  @@unique([role_id, perm_id])
  @@index([tenant_id])
  @@index([role_id])
  @@index([perm_id])
  @@map("sys_role_permission")
}

// ==================== 角色部门关联表（数据权限） ====================
model sys_role_dept {
  id         String   @id @default(uuid()) @db.Uuid
  role_id    String   @db.Uuid
  dept_id    String   @db.Uuid
  tenant_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6) /// 创建时间
  created_by String?  @db.Uuid /// 创建人ID

  role sys_role @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  dept sys_dept @relation(fields: [dept_id], references: [dept_id], onDelete: Cascade)

  @@unique([role_id, dept_id])
  @@index([tenant_id])
  @@index([role_id])
  @@index([dept_id])
  @@map("sys_role_dept")
}

// ==================== MFA 配置表 ====================
model sys_mfa_config {
  mfa_id       String   @id @default(uuid()) @db.Uuid
  user_id      String   @unique @db.Uuid
  secret       String   @db.VarChar(256)
  enabled      Int      @default(0) @db.SmallInt
  backup_codes String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6) /// 更新时间
  created_by   String?  @db.Uuid /// 创建人ID

  @@index([user_id])
  @@map("sys_mfa_config")
}

// ==================== 文件表 ====================
model sys_file {
  file_id    String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  filename   String   @db.VarChar(256)
  url        String   @db.VarChar(512)
  size       Int      @db.Integer
  mime_type  String?  @db.VarChar(128)
  uploader   String?  @db.Uuid
  category   String   @default("other")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  is_deleted Int      @default(0) @db.SmallInt
  md5        String?  @db.VarChar(32)

  @@index([tenant_id])
  @@map("sys_file")
}

// ==================== 登录日志表 ====================
model sys_login_log {
  log_id          String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  user_id         String?  @db.Uuid
  username        String   @db.VarChar(64)
  ip_address      String   @db.VarChar(64)
  user_agent      String?  @db.VarChar(512)
  status          String   @default("1") @db.VarChar(10)
  message         String?  @db.VarChar(256)
  created_at      DateTime @default(now()) @db.Timestamptz(6) /// 创建时间
  created_by      String?  @db.Uuid /// 创建人ID
  is_abnormal     Int      @default(0) @db.SmallInt /// 0-正常 1-异常
  abnormal_reason String?  @db.VarChar(256) /// 异常原因描述
  abnormal_type   String?  @db.VarChar(32) /// new_ip | new_device | impossible_travel | unusual_time
  country         String?  @db.VarChar(64)
  province        String?  @db.VarChar(64)
  city            String?  @db.VarChar(64)
  isp             String?  @db.VarChar(64)
  notify_status   Int      @default(0) @db.SmallInt /// 0-未通知 1-已通知

  @@index([tenant_id, is_abnormal, created_at(sort: Desc)])
  @@index([tenant_id])
  @@index([user_id])
  @@index([created_at])
  @@map("sys_login_log")
}

// ==================== 系统配置表 ====================
model sys_config {
  config_id    String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  config_key   String   @db.VarChar(128)
  config_value String?  @db.Text
  description  String?  @db.VarChar(512)
  created_by   String?  @db.Uuid
  updated_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  is_deleted   Int      @default(0) @db.SmallInt

  @@unique([tenant_id, config_key])
  @@index([tenant_id])
  @@map("sys_config")
}

// ==================== 定时任务 ====================
model sys_job {
  job_id             String    @id @default(uuid()) @db.Uuid
  tenant_id          String    @db.Uuid
  job_name           String    @db.VarChar(128)
  job_group          String    @default("DEFAULT") @db.VarChar(64)
  invoke_target      String    @db.VarChar(256)
  cron_expression    String    @db.VarChar(64)
  misfire_policy     Int       @default(3) @db.SmallInt
  concurrent         Int       @default(1) @db.SmallInt
  status             String    @default("1") @db.VarChar(10)
  remark             String?   @db.VarChar(512)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  created_by         String?   @db.Uuid
  updated_by         String?   @db.Uuid
  is_deleted         Int       @default(0) @db.SmallInt
  retry_count        Int       @default(0) @db.SmallInt // 失败重试次数
  retry_interval     Int       @default(60) @db.Integer // 重试间隔（秒）
  timeout_seconds    Int       @default(300) @db.Integer // 超时
  is_paused          Int       @default(0) @db.SmallInt // 暂停
  last_run_at        DateTime? @db.Timestamptz(6)
  next_run_at        DateTime? @db.Timestamptz(6)
  alert_enabled      Int       @default(0) @db.SmallInt // 是否开启告警
  alert_channels     String?   @db.VarChar(128) // email,sms,webhook
  alert_receivers    String?   @db.VarChar(512) // 逗号分隔
