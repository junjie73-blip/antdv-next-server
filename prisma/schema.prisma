// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== 全局枚举 ====================
enum RecordStatus {
  ACTIVE
  INACTIVE
  PENDING
  EXPIRED
  LOCKED
}

enum MenuType {
  DIRECTORY
  MENU
  BUTTON
}

enum NotificationType {
  SYSTEM
  ANNOUNCEMENT
  PERSONAL
  TASK
}

enum NotificationTargetType {
  ALL
  ROLE
  USER
}

enum UploadType {
  SINGLE
  CHUNKED
}

// ==================== 租户表 ====================
model Tenant {
  id        String       @id @default(uuid())
  name      String
  domain    String?      @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("tenants")
}

// ==================== 文件上传表 ====================
model FileUpload {
  id          String     @id @default(uuid())
  uploadId    String     @unique
  tenantId    String
  userId      String?
  filename    String
  mimeType    String
  size        Int
  uploadType  UploadType @default(SINGLE)
  totalChunks Int        @default(1)
  chunks      Int        @default(0)
  blobUrl     String?
  status      String     @default("PENDING")
  metadata    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId, status])
  @@index([uploadId])
  @@map("file_uploads")
}

// ==================== RBAC 核心表 ====================
model User {
  id            String       @id @default(uuid())
  username      String
  email         String?
  phone         String?
  passwordHash  String?
  name          String?
  nickname      String?
  avatar        String?
  role          String?
  status        RecordStatus @default(ACTIVE)
  tenantId      String
  mfaSecret     String?
  mfaEnabled    Boolean      @default(false)
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  refreshTokens         RefreshToken[]
  oauthAccounts         OAuthAccount[]
  auditLogs             AuditLog[]
  userRoles             UserRole[]
  receivedNotifications UserNotification[]

  @@unique([username, tenantId, deletedAt])
  @@index([tenantId, status, deletedAt])
  @@index([email, tenantId])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  isSystem    Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  roleMenus       RoleMenu[]

  @@unique([tenantId, code, deletedAt])
  @@index([tenantId, status, deletedAt])
  @@map("roles")
}

model Permission {
  id          String       @id @default(uuid())
  tenantId    String
  code        String
  name        String
  resource    String
  action      String
  description String?
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  rolePermissions RolePermission[]
  menuPermissions MenuPermission[]

  @@unique([tenantId, code, deletedAt])
  @@map("permissions")
}

// ==================== 菜单管理表 ====================
model Menu {
  id             String       @id @default(uuid())
  tenantId       String
  parentId       String?
  name           String
  code           String
  path           String?
  component      String?
  icon           String?
  sortOrder      Int          @default(0)
  menuType       MenuType     @default(MENU)
  isExternal     Boolean      @default(false)
  isCache        Boolean      @default(true)
  isVisible      Boolean      @default(true)
  permissionCode String?
  status         RecordStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  parent          Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id])
  children        Menu[]           @relation("MenuHierarchy")
  roleMenus       RoleMenu[]
  menuPermissions MenuPermission[]

  @@index([tenantId, parentId, status, deletedAt])
  @@index([tenantId, menuType, status, deletedAt])
  @@map("menus")
}

model RoleMenu {
  id       String @id @default(uuid())
  roleId   String
  menuId   String
  tenantId String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId])
  @@index([tenantId, roleId])
  @@map("role_menus")
}

model MenuPermission {
  id           String     @id @default(uuid())
  menuId       String
  permissionId String
  tenantId     String
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([menuId, permissionId])
  @@map("menu_permissions")
}

// ==================== 通知系统表 ====================
model Notification {
  id              String                @id @default(uuid())
  tenantId        String
  title           String
  content         String?
  type            NotificationType
  targetType      NotificationTargetType
  targetRoles     String?
  targetUsers     String?
  isRead          Boolean               @default(false)
  priority        Int                   @default(0)
  publishAt       DateTime?
  expireAt        DateTime?
  status          RecordStatus          @default(ACTIVE)
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  userNotifications UserNotification[]

  @@index([tenantId, type, status, deletedAt])
  @@index([tenantId, targetType, status])
  @@map("notifications")
}

model UserNotification {
  id             String       @id @default(uuid())
  userId         String
  notificationId String
  tenantId       String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([tenantId, userId, isRead])
  @@map("user_notifications")
}

// ==================== 数据字典表 ====================
model Dictionary {
  id          String       @id @default(uuid())
  tenantId    String
  code        String
  name        String
  category    String
  description String?
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items DictionaryItem[]

  @@unique([tenantId, code, deletedAt])
  @@index([tenantId, category, status])
  @@map("dictionaries")
}

model DictionaryItem {
  id          String       @id @default(uuid())
  dictId      String
  tenantId    String
  label       String
  value       String
  sortOrder   Int          @default(0)
  isDefault   Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  dictionary Dictionary @relation(fields: [dictId], references: [id], onDelete: Cascade)

  @@unique([dictId, value, deletedAt])
  @@index([tenantId, dictId, status])
  @@map("dictionary_items")
}

// ==================== 审计日志表 ====================
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    String?
  ip         String?
  ua         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, action, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ==================== RBAC 关联表 ====================
model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}