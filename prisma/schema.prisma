  description  String?  @db.VarChar(512)
  status       String   @default("1") @db.VarChar(2) /// 0-禁用 1-启用
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  created_by   String?  @db.Uuid
  updated_by   String?  @db.Uuid
  is_deleted   Int      @default(0) @db.SmallInt

  @@index([tenant_id, status])
  @@index([tenant_id, field])
  @@index([is_deleted])
  @@map("sys_field_mask_policy")
}

// ==================== 慢查询日志 ====================
model sys_slow_query_log {
  id            String    @id @default(uuid()) @db.Uuid
  tenant_id     String?   @db.Uuid /// 部分系统查询无租户
  fingerprint   String    @db.VarChar(64) /// SQL 归一化后的 hash
  query_sample  String    @db.Text /// 截断后的样本 SQL
  query_hash    String    @db.VarChar(64)
  calls         Int       @default(1)
  total_time_ms Int       @default(0)
  mean_time_ms  Int       @default(0)
  max_time_ms   Int       @default(0)
  p95_time_ms   Int       @default(0)
  rows          Int       @default(0)
  first_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime  @default(now()) @db.Timestamptz(6)
  status        String    @default("open") @db.VarChar(20) /// open | resolved | ignored
  reviewer_id   String?   @db.Uuid
  review_note   String?   @db.Text
  reviewed_at   DateTime? @db.Timestamptz(6)

  @@unique([fingerprint])
  @@index([status, mean_time_ms(sort: Desc)])
  @@index([last_seen_at(sort: Desc)])
  @@map("sys_slow_query_log")
}

// ==================== 代码生成器模板 ====================
model gen_template {
  template_id     String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  template_key    String   @db.VarChar(64) /// controller / service / vue ...
  template_name   String   @db.VarChar(128)
  category        String   @default("backend") @db.VarChar(32) /// backend | frontend | sql
  current_version Int      @default(1)
  status          String   @default("1") @db.VarChar(10)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)
  created_by      String?  @db.Uuid
  updated_by      String?  @db.Uuid
  is_deleted      Int      @default(0) @db.SmallInt

  versions gen_template_version[]

  @@unique([tenant_id, template_key])
  @@index([tenant_id, category])
  @@map("gen_template")
}

model gen_template_version {
  version_id  String   @id @default(uuid()) @db.Uuid
  template_id String   @db.Uuid
  tenant_id   String   @db.Uuid
  version     Int
  content     String   @db.Text /// Handlebars 模板内容
  changelog   String?  @db.VarChar(512)
  is_current  Int      @default(0) @db.SmallInt
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  created_by  String?  @db.Uuid

  template gen_template @relation(fields: [template_id], references: [template_id], onDelete: Cascade)

  @@unique([template_id, version])
  @@index([tenant_id, template_id])
  @@map("gen_template_version")
}

// ==================== API 版本 ====================
model sys_api_version {
  version_id    String    @id @default(uuid()) @db.Uuid
  version_code  String    @unique @db.VarChar(16) /// "v1" / "v2"
  version_name  String    @db.VarChar(64) /// 展示名
  status        String    @default("active") @db.VarChar(16) /// active | deprecated | sunset
  release_at    DateTime  @db.Timestamptz(6)
  is_default    Int       @default(0) @db.SmallInt
  deprecated_at DateTime? @db.Timestamptz(6) /// 开始标记废弃
  sunset_at     DateTime? @db.Timestamptz(6) /// 停止服务时间
  description   String?   @db.VarChar(512)
  changelog     Json?
  is_deleted    Int       @default(0) @db.SmallInt
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid

  @@index([status])
  @@index([is_default])
  @@map("sys_api_version")
}

/// ==================== 特性开关 ====================
model sys_feature_flag {
  flag_id     String                  @id @default(uuid()) @db.Uuid
  flag_key    String                  @unique @db.VarChar(128) /// 唯一标识，如 "new-workflow-editor"
  flag_name   String                  @db.VarChar(128)
  description String?                 @db.VarChar(512)
  /// 默认状态：0-关闭 1-开启
  default_on  Int                     @default(0) @db.SmallInt
  /// 全局灰度百分比 0-100
  rollout_pct Int                     @default(0) @db.SmallInt
  /// 状态：1-启用 0-停用（停用后走 default_on）
  status      String                  @default("1") @db.VarChar(10)
  /// 计划下线时间（提醒清理）
  expire_at   DateTime?               @db.Timestamptz(6)
  tags        Json? /// ["experimental", "billing"]
  created_at  DateTime                @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                @updatedAt @db.Timestamptz(6)
  created_by  String?                 @db.Uuid
  updated_by  String?                 @db.Uuid
  is_deleted  Int                     @default(0) @db.SmallInt
  owner       String?                 @db.VarChar(128)
  /// ⭐ 新增：逻辑分组，如 "workflow" / "billing"
  group_name  String?                 @db.VarChar(64)
  /// ⭐ 新增：变更计数（便于前端判断缓存是否失效）
  version     Int                     @default(1)
  rules       sys_feature_flag_rule[]

  @@index([status])
  @@index([expire_at])
  @@map("sys_feature_flag")
}

/// ==================== 特性开关灰度规则 ====================
model sys_feature_flag_rule {
  rule_id         String           @id @default(uuid()) @db.Uuid
  flag_id         String           @db.Uuid
  tenant_id       String?          @db.Uuid /// null 表示全局规则
  /// 规则类型：tenant | user | role | percentage
  rule_type       String           @db.VarChar(16)
  /// 目标值（tenant_id / user_id / role_id 或百分比数字）
  target          String           @db.VarChar(128)
  /// 0-关闭 1-开启
  enabled         Int              @default(1) @db.SmallInt
  /// 优先级（数值越大越优先）
  priority        Int              @default(0)
  remark          String?          @db.VarChar(256)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)
  created_by      String?          @db.Uuid
  is_deleted      Int              @default(0) @db.SmallInt
  effective_from  DateTime?        @db.Timestamptz(6)
  effective_until DateTime?        @db.Timestamptz(6)
  /// ⭐ 新增：过期自动清理
  expire_at       DateTime?        @db.Timestamptz(6)
  flag            sys_feature_flag @relation(fields: [flag_id], references: [flag_id], onDelete: Cascade)

  @@index([flag_id])
  @@index([tenant_id])
  @@index([rule_type])
  @@map("sys_feature_flag_rule")
}

/// ==================== 数据库备份记录 ====================
model sys_backup_record {
  backup_id     String    @id @default(uuid()) @db.Uuid
  /// 触发方式：manual | cron | pre_migrate
  trigger_type  String    @db.VarChar(20)
  /// 备份类型：full | schema_only | data_only
  backup_type   String    @default("full") @db.VarChar(20)
  /// 状态：pending | running | completed | failed
  status        String    @default("pending") @db.VarChar(20)
  /// 对象存储 key（不含 bucket）
  storage_key   String?   @db.VarChar(512)
  /// 文件名
  file_name     String?   @db.VarChar(256)
  /// 文件大小（字节）
  file_size     BigInt?
  /// 压缩格式：gzip | zstd | none
  compression   String    @default("gzip") @db.VarChar(16)
  /// 数据库信息
  database_name String    @db.VarChar(64)
  database_size BigInt?
  /// 校验和（sha256）
  checksum      String?   @db.VarChar(64)
  /// 耗时（毫秒）
  duration_ms   Int?
  /// 错误信息
  error_msg     String?   @db.Text
  /// 保留策略：保留至某日（超过可清理）
  retain_until  DateTime? @db.Timestamptz(6)
  /// 备注
  remark        String?   @db.VarChar(512)
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  finished_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  created_by    String?   @db.Uuid

  @@index([status])
  @@index([trigger_type])
  @@index([started_at(sort: Desc)])
  @@index([retain_until])
  @@map("sys_backup_record")
}

/// ==================== 备份策略配置 ====================
model sys_backup_policy {
  policy_id    String   @id @default(uuid()) @db.Uuid
  /// 策略名
  name         String   @db.VarChar(128)
  /// cron 表达式
  cron         String   @db.VarChar(64)
  /// 备份类型
  backup_type  String   @default("full") @db.VarChar(20)
  /// 保留天数
  retain_days  Int      @default(30)
  /// 保留份数上限
  retain_count Int      @default(10)
  /// 是否启用
  enabled      Int      @default(1) @db.SmallInt
  /// 存储桶（为空则用默认）
  bucket       String?  @db.VarChar(128)
  remark       String?  @db.VarChar(512)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  created_by   String?  @db.Uuid
  updated_by   String?  @db.Uuid
  is_deleted   Int      @default(0) @db.SmallInt

  @@index([enabled])
  @@map("sys_backup_policy")
}

/// ==================== 通用导出任务 ====================
model sys_export_task {
  task_id          String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  user_id          String    @db.Uuid
  /// 业务类型：user | audit_log | login_log | notice | ... 
  biz_type         String    @db.VarChar(64)
  /// 导出格式：xlsx | csv | json
  export_format    String    @default("xlsx") @db.VarChar(16)
  /// 查询条件 JSON（前端传什么存什么）
  query_params     Json?
  /// 请求字段（列筛选）
  columns          Json?
  /// 状态：pending | processing | completed | failed | cancelled | expired
  status           String    @default("pending") @db.VarChar(20)
  progress         Int       @default(0) @db.SmallInt /// 0-100
  row_count        Int       @default(0)
  /// 文件信息
  file_url         String?   @db.VarChar(512)
  file_name        String?   @db.VarChar(256)
  file_size        BigInt?
  /// 失败信息
  error_msg        String?   @db.Text
  /// BullMQ Job ID
  job_id           String?   @db.VarChar(64)
  /// 重试
  retry_count      Int       @default(0) @db.SmallInt
  max_retries      Int       @default(3) @db.SmallInt
  /// 时间戳
  started_at       DateTime? @db.Timestamptz(6)
  completed_at     DateTime? @db.Timestamptz(6)
  expires_at       DateTime? @db.Timestamptz(6)
  duration_ms      Int?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  is_deleted       Int       @default(0) @db.SmallInt
  error_type       String?   @db.VarChar(32)
  error_stack      String?   @db.Text
  download_count   Int       @default(0) @db.SmallInt
  last_download_ip String?   @db.VarChar(64)

  @@index([tenant_id, user_id, status, created_at(sort: Desc)])
  @@index([status, created_at])
  @@index([expires_at])
  @@index([biz_type])
  @@map("sys_export_task")
}

/// ==================== 租户隔离扫描记录 ====================
model sys_tenant_isolation_scan {
  scan_id       String    @id @default(uuid()) @db.Uuid
  /// 扫描类型：schema（表结构）| query（SQL 审计）| runtime（运行时）
  scan_type     String    @db.VarChar(20)
  /// 触发的规则
  rule_code     String    @db.VarChar(64)
  /// 违规级别：info | warning | critical
  severity      String    @db.VarChar(16)
  /// 涉及的表
  table_name    String?   @db.VarChar(128)
  /// 涉及的列
  column_name   String?   @db.VarChar(128)
  /// 违规描述
  message       String    @db.Text
  /// 详细上下文 JSON
  context       Json?
  /// 修复建议
  suggestion    String?   @db.Text
  /// 是否已修复
  resolved      Int       @default(0) @db.SmallInt
  resolved_at   DateTime? @db.Timestamptz(6)
  resolved_by   String?   @db.Uuid
  /// 首次发现时间（相同规则+表会更新此字段）
  first_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  last_seen_at  DateTime  @default(now()) @db.Timestamptz(6)
  /// 出现次数
  hit_count     Int       @default(1)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([rule_code, table_name, column_name])
  @@index([severity])
  @@index([resolved])
  @@index([last_seen_at])
  @@map("sys_tenant_isolation_scan")
}

/// ==================== 隔离审计的扫描批次 ====================
model sys_tenant_isolation_run {
  run_id         String    @id @default(uuid()) @db.Uuid
  /// 触发方式：ci | manual | cron | startup
  trigger_type   String    @db.VarChar(16)
  /// 触发者（cron 为 null）
  triggered_by   String?   @db.Uuid
  /// 状态：running | completed | failed
  status         String    @default("running") @db.VarChar(16)
  /// 各类违规计数
  critical_count Int       @default(0)
  warning_count  Int       @default(0)
  info_count     Int       @default(0)
  /// 新增 / 已修复
  new_count      Int       @default(0)
  resolved_count Int       @default(0)
  /// 扫描了哪些（快照）
  scanned_tables Int       @default(0)
  scanned_files  Int       @default(0)
  /// 耗时
  duration_ms    Int?
  error_msg      String?   @db.Text
  started_at     DateTime  @default(now()) @db.Timestamptz(6)
  finished_at    DateTime? @db.Timestamptz(6)

  @@index([trigger_type, started_at(sort: Desc)])
  @@index([status])
  @@map("sys_tenant_isolation_run")
}

/// ==================== 组织架构变更历史 ====================
model sys_org_history {
  history_id             String    @id @default(uuid()) @db.Uuid
  tenant_id              String    @db.Uuid
  /// 实体类型：dept | user | user_dept | user_role
  entity_type            String    @db.VarChar(32)
  /// 实体 ID
  entity_id              String    @db.Uuid
  /// 变更类型：create | update | delete | move | transfer
  change_type            String    @db.VarChar(16)
  /// 变更前快照（JSON）
  before_data            Json?
  /// 变更后快照（JSON）
  after_data             Json?
  /// 变更摘要（人可读）
  summary                String?   @db.VarChar(512)
  /// 触发来源：app | trigger | import | api
  source                 String    @default("app") @db.VarChar(16)
  /// 操作者
  operator_id            String?   @db.Uuid
  operator_name          String?   @db.VarChar(64)
  ip_address             String?   @db.VarChar(64)
  /// 关联请求追踪
  trace_id               String?   @db.VarChar(64)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  scope                  String?   @db.VarChar(32)
  related_id             String?   @db.Uuid
  reversible             Int       @default(1) @db.SmallInt
  reverted_at            DateTime? @db.Timestamptz(6)
  reverted_by            String?   @db.Uuid
  revert_reason          String?   @db.VarChar(512)
  reverted_by_history_id String?   @db.Uuid
  trigger_source         String    @default("cron") @db.VarChar(20)
  trigger_reason         String?   @db.VarChar(512)
  trigger_history_ids    Json?
  reverts_history_id     String?   @db.Uuid

  @@index([reverted_by_history_id])
  @@index([reverts_history_id])
  @@index([tenant_id, entity_type, entity_id, created_at(sort: Desc)])
  @@index([tenant_id, created_at(sort: Desc)])
  @@index([operator_id])
  @@index([created_at])
  @@index([tenant_id, scope, created_at(sort: Desc)])
  @@index([tenant_id, change_type, created_at(sort: Desc)])
  @@index([related_id])
  @@map("sys_org_history")
}

/// ==================== 组织架构快照 ====================
model sys_org_snapshot {
  snapshot_id   String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  snapshot_date DateTime @db.Date
  /// 类型：dept_tree（部门树）| user_org（用户-部门映射）| full
  snapshot_type String   @db.VarChar(20)
  /// 快照数据（JSON）
  data          Json
  /// 统计
  user_count    Int      @default(0)
  dept_count    Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tenant_id, snapshot_date, snapshot_type])
  @@index([tenant_id, snapshot_date(sort: Desc)])
  @@map("sys_org_snapshot")
}

/// ==================== 字段级数据权限策略 ====================
model sys_role_field_policy {
  policy_id  String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  role_id    String   @db.Uuid
  /// 资源标识：如 "user" / "order" / "customer"
  resource   String   @db.VarChar(64)
  /// 字段名（snake_case）
  field      String   @db.VarChar(128)
  /// 访问权限：read | write | deny
  access     String   @default("read") @db.VarChar(16)
  /// 脱敏类型：none | full | partial | hash | regex
  mask_type  String   @default("none") @db.VarChar(16)
  /// 脱敏参数 JSON，如 { prefix: 3, suffix: 4 } 或 { regex: "..." }
  mask_rule  Json?
  /// 备注
  remark     String?  @db.VarChar(256)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  is_deleted Int      @default(0) @db.SmallInt

  @@unique([role_id, resource, field])
  @@index([tenant_id, resource])
  @@index([role_id])
  @@map("sys_role_field_policy")
}
