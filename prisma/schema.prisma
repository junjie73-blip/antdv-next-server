/// ==================== 流程定义 ====================
model wf_definition {
  def_id          String        @id @default(uuid()) @db.Uuid
  tenant_id       String        @db.Uuid
  def_key         String        @db.VarChar(64) /// 流程唯一标识
  def_name        String        @db.VarChar(128)
  version         Int           @default(1) /// 版本号
  category        String?       @db.VarChar(64) /// 分类
  description     String?       @db.VarChar(512)
  definition      Json /// BPMN JSON 定义
  definition_xml  String?       @db.Text /// BPMN XML 原文（画布还原用）
  /**
   * 表单配置 [{ field, label, type, required }]
   */
  form_schema     Json?
  /**
   * 变量定义 [{ name, type, defaultValue }]
   */
  var_schema      Json?
  status          String        @default("1") @db.VarChar(10) /// 0-草稿 1-已发布 2-已停用
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @updatedAt @db.Timestamptz(6)
  created_by      String?       @db.Uuid
  updated_by      String?       @db.Uuid
  is_deleted      Int           @default(0) @db.SmallInt
  edge_conditions Json?
  var_meta        Json?
  instances       wf_instance[]

  @@unique([tenant_id, def_key, version])
  @@index([tenant_id, status])
  @@index([is_deleted])
  @@map("wf_definition")
}

/// ==================== 流程实例 ====================
model wf_instance {
  instance_id         String            @id @default(uuid()) @db.Uuid
  tenant_id           String            @db.Uuid
  def_id              String            @db.Uuid
  def_key             String            @db.VarChar(64)
  def_version         Int
  business_key        String?           @db.VarChar(128) /// 业务单号
  title               String            @db.VarChar(256)
  initiator_id        String            @db.Uuid /// 发起人
  initiator_dept_id   String?           @db.Uuid /// 发起人部门
  variables           Json /// 流程变量快照
  /**
   * 当前活跃节点列表（支持并行）
   */
  active_nodes        Json              @default("[]")
  status              String            @default("0") @db.VarChar(20)
  /**
   * 0-运行中 1-已完成 2-已终止 3-已挂起
   */
  start_at            DateTime          @default(now()) @db.Timestamptz(6)
  end_at              DateTime?         @db.Timestamptz(6)
  duration_ms         Int? /// 总耗时
  parent_instance_id  String?           @db.Uuid /// 子流程场景
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @updatedAt @db.Timestamptz(6)
  is_deleted          Int               @default(0) @db.SmallInt
  priority            Int?              @default(0) /// 优先级
  def                 wf_definition     @relation(fields: [def_id], references: [def_id])
  tasks               wf_task[]
  variables_log       wf_variable_log[]
  history             wf_history[]
  /// 超时通知时间（避免重复通知）
  timeout_notified_at DateTime?         @db.Timestamptz(6)
  /// 最后超时扫描时间
  last_scanned_at     DateTime?         @db.Timestamptz(6)

  @@index([tenant_id, status])
  @@index([tenant_id, initiator_id])
  @@index([tenant_id, business_key])
  @@index([parent_instance_id])
  @@index([tenant_id, def_key, status])
  @@index([tenant_id, start_at(sort: Desc)])
  @@map("wf_instance")
}

/// ==================== 任务 ====================
model wf_task {
  task_id                String      @id @default(uuid()) @db.Uuid
  tenant_id              String      @db.Uuid
  instance_id            String      @db.Uuid
  node_id                String      @db.VarChar(64) /// 节点 ID
  node_name              String      @db.VarChar(128)
  node_type              String      @db.VarChar(32) /// userTask | countersign | orSign
  assignee_id            String?     @db.Uuid /// 审批人
  assignee_type          String      @db.VarChar(32) /// user | role | dept | initiator
  candidate_ids          Json? /// 候选用户列表（多签场景）
  sign_type              String?     @db.VarChar(20) /// all-会签 any-或签 sequential-顺序
  sign_strategy          Json? /// { percent: 60 } 比例通过
  completed_ids          Json?       @default("[]") /// 已签署用户
  status                 String      @default("0") @db.VarChar(20)
  /// 0-待处理 1-已完成 2-已取消 3-已超时
  action                 String?     @db.VarChar(32) /// approve | reject | ...
  comment                String?     @db.Text
  /**
   * 表单提交数据
   */
  form_data              Json?
  due_at                 DateTime?   @db.Timestamptz(6)
  claimed_at             DateTime?   @db.Timestamptz(6)
  completed_at           DateTime?   @db.Timestamptz(6)
  duration_ms            Int?
  created_at             DateTime    @default(now()) @db.Timestamptz(6)
  updated_at             DateTime    @updatedAt @db.Timestamptz(6)
  is_deleted             Int         @default(0) @db.SmallInt
  priority               Int?        @default(0) /// 优先级
  instance               wf_instance @relation(fields: [instance_id], references: [instance_id])
  original_assignee_id   String?     @db.Uuid /// 加签前原审批人
  is_add_sign            Int         @default(0) @db.SmallInt
  add_sign_type          String?     @db.VarChar(16) /// before | after
  add_sign_parent_id     String?     @db.Uuid
  transferred_from_id    String?     @db.Uuid
  transferred_at         DateTime?   @db.Timestamptz(6)
  escalation_level       Int         @default(0) @db.SmallInt /// 已升级次数
  escalated_at           DateTime?   @db.Timestamptz(6)
  escalated_to           String?     @db.Uuid
  add_sign_chain_root_id String?     @db.Uuid
  rollback_from_task_id  String?     @db.Uuid
  node_visit_count       Int         @default(1) @db.Integer

  @@index([original_assignee_id])
  @@index([add_sign_chain_root_id])
  @@index([rollback_from_task_id])
  @@index([add_sign_parent_id])
  @@index([tenant_id, assignee_id, status])
  @@index([tenant_id, instance_id])
  @@index([tenant_id, node_id, status])
  @@index([tenant_id, due_at])
  @@index([due_at])
  @@index([tenant_id, assignee_id, status, priority])
  @@map("wf_task")
}

/// ==================== 流程历史 ====================
model wf_history {
  history_id    String   @id @default(uuid()) @db.Uuid
