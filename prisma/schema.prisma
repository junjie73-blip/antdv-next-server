model gen_table {
  table_id         String             @id @default(uuid()) @db.Uuid
  table_name       String             @unique @db.VarChar(200)
  table_comment    String?            @db.VarChar(500)
  class_name       String             @db.VarChar(100)
  tpl_category     String             @default("crud") @db.VarChar(20)
  package_name     String?            @db.VarChar(100)
  module_name      String?            @db.VarChar(30)
  business_name    String?            @db.VarChar(30)
  function_name    String?            @db.VarChar(50)
  function_author  String?            @db.VarChar(50)
