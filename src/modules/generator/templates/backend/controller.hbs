  protected buildListWhere(query: Record<string, unknown>): Record<string, unknown> {
    const where: Record<string, unknown> = {};
{{#each queryColumns}}
  {{#if (eq queryType "EQ")}}
    if (query.{{fieldName}} !== undefined && query.{{fieldName}} !== "") {
      where.{{columnName}} = query.{{fieldName}};
    }
  {{else if (eq queryType "NE")}}
    if (query.{{fieldName}} !== undefined && query.{{fieldName}} !== "") {
      where.{{columnName}} = { not: query.{{fieldName}} };
    }
  {{else if (eq queryType "GT")}}
    if (query.{{fieldName}} !== undefined) {
      where.{{columnName}} = { gt: query.{{fieldName}} };
    }
  {{else if (eq queryType "LT")}}
    if (query.{{fieldName}} !== undefined) {
      where.{{columnName}} = { lt: query.{{fieldName}} };
    }
  {{/if}}
{{/each}}
    return where;
  }

