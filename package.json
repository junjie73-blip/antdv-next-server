  "scripts": {
    "generate:modules": "tsx scripts/generate-modules.ts",
    "watch:modules": "chokidar \"./src/modules/*/controller.ts\" -c \"pnpm generate:modules\" --initial",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev": "concurrently -n server,worker \"nodemon\" \"tsx watch src/worker.ts\" ",
    "build": "pnpm db:generate  && tsc  && tsc-alias -p tsconfig.json --dir dist",
    "start": "node ./dist/src/index.js",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:server": "nodemon",
    "start:worker": "node dist/src/worker.js"
  }
