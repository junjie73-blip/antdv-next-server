generator client {
    provider               = "prisma-client"
    output                 = "../src/generated/prisma"
    moduleFormat           = "esm"
    generatedFileExtension = "ts"
    importFileExtension    = "js"
}

datasource db {
    provider = "postgresql"
}

/// 用户凭据（只含认证必需字段，业务档案在 user-svc）
model sys_user {
    user_id              String    @id @db.Uuid
    tenant_id            String    @db.Uuid
    username             String    @db.VarChar(64)
    password             String    @db.VarChar(255)
    status               String    @default("1") @db.Char(1)
    is_deleted           Int       @default(0)
    must_change_password Int       @default(0)
    password_changed_at  DateTime?
    cancelled_at         DateTime?
    cancel_effective     DateTime?
    last_login_ip        String?   @db.VarChar(64)
    last_login_time      DateTime?

    user_roles sys_user_role[]

    @@index([tenant_id, username])
    @@index([tenant_id, is_deleted])
    @@map("sys_user")
}

model sys_role {
    role_id    String   @id @default(uuid()) @db.Uuid
    tenant_id  String   @db.Uuid
    role_code  String   @db.VarChar(64)
    role_name  String   @db.VarChar(128)
    data_scope String   @default("1") @db.VarChar(8)
    status     String   @default("1") @db.Char(1)
    is_deleted Int      @default(0)
    sort_order Int      @default(0)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    role_permissions sys_role_permission[]
    user_roles       sys_user_role[]

    @@unique([tenant_id, role_code])
    @@index([tenant_id, is_deleted])
    @@map("sys_role")
}

model sys_permission {
    perm_id       String   @id @default(uuid()) @db.Uuid
    tenant_id     String   @db.Uuid
    perm_code     String   @db.VarChar(128)
    perm_name     String   @db.VarChar(128)
    resource_type String   @db.VarChar(32)
    perm_action   String?  @db.VarChar(32)
    status        String   @default("1") @db.Char(1)
    is_deleted    Int      @default(0)
    created_at    DateTime @default(now())

    role_permissions sys_role_permission[]

    @@unique([tenant_id, perm_code])
    @@index([tenant_id, is_deleted])
    @@map("sys_permission")
}

model sys_user_role {
    id        String @id @default(uuid()) @db.Uuid
    user_id   String @db.Uuid
    role_id   String @db.Uuid
    tenant_id String @db.Uuid

    user sys_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
    role sys_role @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

    @@unique([user_id, role_id])
    @@index([tenant_id])
    @@map("sys_user_role")
}

model sys_role_permission {
    id        String @id @default(uuid()) @db.Uuid
    role_id   String @db.Uuid
    perm_id   String @db.Uuid
    tenant_id String @db.Uuid

    role sys_role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
    perm sys_permission @relation(fields: [perm_id], references: [perm_id], onDelete: Cascade)

    @@unique([role_id, perm_id])
    @@index([tenant_id])
    @@map("sys_role_permission")
}
