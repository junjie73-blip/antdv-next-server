server {
    listen 80;
    server_name 121.4.127.82;
    return 301 https://$host$request_uri; # HTTP 自动跳转 HTTPS
}

server {
    listen 443 ssl;
    server_name 121.4.127.82;

    # 证书路径（确保你之前的权限已经设置好）
    ssl_certificate /etc/nginx/ssl/121.4.127.82.crt;
    ssl_certificate_key /etc/nginx/ssl/121.4.127.82.key;

    root /www/wwwroot/frontend/antdv;
    index index.html;

    # 【关键点1：文件上传大小限制】
    # 允许客户端上传的最大文件大小，默认是1M，这里改成 100M，按需调整
    client_max_body_size 100M;

    # 前端 Vue 路由
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 【关键点2：WebSocket 代理】
    # 假设你的前端和后端约定的 WebSocket 路径是 /ws/，如果是 /socket.io/ 请替换
    location /ws/ {
        proxy_pass http://127.0.0.1:3000/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
    }

    # 后端 API 接口代理
    location /api {
        proxy_pass http://127.0.0.1:3000/api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 【关键点3：文件上传后的静态访问】
    # 场景A：如果你后端 Node 把文件存在了本地磁盘（例如 /www/wwwroot/backend/uploads），并且想通过 URL 直接访问
    location /uploads/ {
        alias /www/wwwroot/backend/antdv/uploads/; # 注意：这里是 alias，不是 root！
        expires 30d; # 缓存30天
    }

    # 场景B：如果你是直接上传到前端目录（极少见，但也可以配）
    # location /uploads/ {
    #     root /www/wwwroot/frontend/antdv;
    #     expires 30d;
    # }
}